# Required: get a private token from https://replicate.com/account/api-tokens
# Rename/copy this file to .env.local and replace the placeholder.
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Optional: defaults are already set to the official Wan 3.0 Prime model.
# You normally do NOT need to add these two variables.
# REPLICATE_MODEL_OWNER=alibaba
# REPLICATE_MODEL_NAME=wan-3-prime

